{
  "name": "@microsoft/terraform-cdk-constructs",
  "description": "Azure CDK constructs using AZAPI provider for direct Azure REST API access. Version 1.0.0 - Major breaking change migration from AzureRM to AZAPI.",
  "repository": {
    "type": "git",
    "url": "https://github.com/azure/terraform-cdk-constructs.git"
  },
  "scripts": {
    "build": "projen build",
    "bump": "projen bump",
    "bump:releasable-commits": "projen bump:releasable-commits",
    "clobber": "projen clobber",
    "compat": "projen compat",
    "compile": "projen compile",
    "default": "projen default",
    "docgen": "projen docgen",
    "eject": "projen eject",
    "eslint": "projen eslint",
    "package": "projen package",
    "package-all": "projen package-all",
    "package:js": "projen package:js",
    "package:python": "projen package:python",
    "post-compile": "projen post-compile",
    "post-upgrade": "projen post-upgrade",
    "pre-compile": "projen pre-compile",
    "release": "projen release",
    "test": "jest --testMatch '**/*.spec.ts'",
    "test:update": "projen test:update",
    "test:watch": "projen test:watch",
    "unbump": "projen unbump",
    "upgrade": "projen upgrade",
    "watch": "projen watch",
    "projen": "projen",
    "integration": "STREAM_OUTPUT=true jest --testMatch '**/*.integ.ts'",
    "integration:nostream": "STREAM_OUTPUT=false jest --maxWorkers=12 --testMatch '**/*.integ.ts'",
    "cleanup-test-resources": "ts-node scripts/cleanup-test-resources.ts",
    "generate-index": "node ./scripts/generate-index.js"
  },
  "author": {
    "name": "Microsoft",
    "url": "https://microsoft.com",
    "organization": false
  },
  "devDependencies": {
    "@cdktn/provider-azapi": "1.0.0",
    "@types/jest": "^29",
    "@types/node": "^20",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8",
    "@typescript-eslint/parser": "^8",
    "cdktn": "0.24.0",
    "cdktn-cli": "0.24.0",
    "commit-and-tag-version": "^13",
    "constructs": "10.7.2",
    "eslint": "^9",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-prettier": "^5.1.3",
    "jest": "^29",
    "jest-junit": "^17",
    "jsii": "~5.9.0",
    "jsii-diff": "^1.98.0",
    "jsii-docgen": "^10.5.0",
    "jsii-pacmak": "^1.103.1",
    "jsii-rosetta": "~5.9.0",
    "prettier": "^3.2.5",
    "projen": "^0.104.4",
    "ts-jest": "^29",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3"
  },
  "peerDependencies": {
    "@cdktn/provider-azapi": "^1.0.0",
    "cdktn": "0.24.0",
    "constructs": "^10.7.2"
  },
  "dependencies": {
    "uuid": "^11.0.3"
  },
  "bundledDependencies": [
    "uuid"
  ],
  "keywords": [
    "azapi",
    "azure",
    "cdk",
    "cdktn",
    "cloud",
    "devops",
    "infrastructure",
    "opentofu",
    "rest-api",
    "terraform"
  ],
  "engines": {
    "node": ">= 22.19.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "yarn",
      "version": "1.22.22",
      "onFail": "ignore"
    }
  },
  "main": "lib/index.js",
  "license": "MIT",
  "stability": "stable",
  "publishConfig": {
    "access": "public"
  },
  "version": "0.0.0",
  "jest": {
    "coverageProvider": "v8",
    "testMatch": [
      "<rootDir>/src/**/__tests__/**/*.ts?(x)",
      "<rootDir>/@(|src)/**/*(*.)@(spec|test|integ).ts?(x)"
    ],
    "clearMocks": true,
    "collectCoverage": true,
    "coverageReporters": [
      "json",
      "lcov",
      "clover",
      "cobertura",
      "text"
    ],
    "coverageDirectory": "coverage",
    "coveragePathIgnorePatterns": [
      "/node_modules/"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/"
    ],
    "watchPathIgnorePatterns": [
      "/node_modules/"
    ],
    "reporters": [
      "default",
      [
        "jest-junit",
        {
          "outputDirectory": "test-reports"
        }
      ]
    ],
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.dev.json"
        }
      ]
    },
    "setupFilesAfterEnv": [
      "<rootDir>/setup.js"
    ],
    "maxWorkers": "100%",
    "globals": {}
  },
  "types": "lib/index.d.ts",
  "jsii": {
    "outdir": "dist",
    "targets": {
      "python": {
        "distName": "microsoft-cdktfconstructs",
        "module": "microsoft_cdktfconstructs"
      }
    },
    "tsconfig": "tsconfig.json",
    "validateTsconfig": "strict"
  },
  "//": "~~ Generated by projen. To modify, edit .projenrc.ts and run \"npx projen\"."
}
